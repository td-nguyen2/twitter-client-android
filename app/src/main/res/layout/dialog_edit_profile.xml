
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header: close, title, save -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- Same X appearance as tweet media preview -->
            <TextView
                android:id="@+id/edit_profile_close"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="×"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/ui_remove_media_background"
                android:contentDescription="Close edit profile"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:text="Edit profile"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#0F1419" />

            <Button
                android:id="@+id/edit_profile_save"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Save"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1D9BF0" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EFF3F4" />

        <!-- Banner and overlapping profile picture -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="220dp">

            <!-- Banner preview -->
            <ImageView
                android:id="@+id/edit_banner_preview"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:background="#CFD9DE"
                android:scaleType="centerCrop"
                android:contentDescription="Profile banner" />

            <!-- Change banner: reuse tweet composer image icon -->
            <ImageView
                android:id="@+id/edit_banner_button"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="55dp"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ui_icon_media"
                android:tint="#FFFFFF"
                android:background="@drawable/ui_profile_upload_background"
                android:contentDescription="Change banner"
                android:clickable="true"
                android:focusable="true" />

            <!-- Profile picture overlapping banner -->
            <FrameLayout
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="16dp">

                <ImageView
                    android:id="@+id/edit_avatar_preview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ui_default_avatar"
                    android:scaleType="centerCrop"
                    android:contentDescription="Profile picture" />

                <!-- Change avatar: same image icon -->
                <ImageView
                    android:id="@+id/edit_avatar_button"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:padding="11dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ui_icon_media"
                    android:tint="#FFFFFF"
                    android:background="@drawable/ui_profile_upload_background"
                    android:contentDescription="Change profile picture"
                    android:clickable="true"
                    android:focusable="true" />

            </FrameLayout>

        </FrameLayout>

        <!-- Existing name and bio editing -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Name"
                android:textSize="14sp"
                android:textColor="#536471" />

            <EditText
                android:id="@+id/edit_profile_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:hint="Your display name"
                android:inputType="textPersonName"
                android:singleLine="true"
                android:textSize="16sp"
                android:textColor="#0F1419"
                android:textColorHint="#8899A6" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Bio"
                android:textSize="14sp"
                android:textColor="#536471" />

            <EditText
                android:id="@+id/edit_profile_bio"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:gravity="top|start"
                android:hint="Tell us about yourself..."
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="280"
                android:textSize="16sp"
                android:textColor="#0F1419"
                android:textColorHint="#8899A6" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
