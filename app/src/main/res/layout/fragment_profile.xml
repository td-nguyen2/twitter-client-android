<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Top navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/buttonBackProfile"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="#0F1419"
            android:textSize="32sp"
            android:contentDescription="Back"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textProfileTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textColor="#0F1419"
                android:textStyle="bold"
                android:textSize="19sp"/>

            <TextView
                android:id="@+id/textProfilePostCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0 posts"
                android:textColor="#536471"
                android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable profile content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Banner and overlapping avatar -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="180dp">

                <ImageView
                    android:id="@+id/imageProfileBanner"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:background="#CFD9DE"
                    android:scaleType="centerCrop"
                    android:contentDescription="Profile banner"/>

                <ImageView
                    android:id="@+id/imageProfileAvatar"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="16dp"
                    android:background="@android:drawable/ic_menu_myplaces"
                    android:contentDescription="Profile avatar"/>
            </FrameLayout>

            <!-- Edit profile button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="end|center_vertical"
                android:paddingHorizontal="16dp">

                <Button
                    android:id="@+id/buttonEditProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Edit profile"
                    android:textAllCaps="false"/>
            </LinearLayout>

            <!-- Profile information -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/textDisplayName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Display name"
                    android:textColor="#0F1419"
                    android:textStyle="bold"
                    android:textSize="21sp"/>

                <TextView
                    android:id="@+id/textUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@username"
                    android:textColor="#536471"
                    android:textSize="15sp"/>

                <TextView
                    android:id="@+id/textBio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text=""
                    android:textColor="#0F1419"
                    android:textSize="15sp"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/textJoinedDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Joined October 2026"
                    android:textColor="#536471"
                    android:textSize="14sp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:id="@+id/textFollowCounts"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0 Following · 0 Followers"
                        android:textColor="#536471"
                        android:textSize="14sp"/>

                    <Button
                        android:id="@+id/buttonFollow"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:minHeight="36dp"
                        android:text="Follow"
                        android:textAllCaps="false"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        android:backgroundTint="#0F1419"
                        android:textColor="#FFFFFF"/>
                </LinearLayout>


            </LinearLayout>

            <!-- Profile tabs -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tabPosts"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Posts"
                    android:textColor="#0F1419"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tabReplies"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Replies"
                    android:textColor="#536471"/>

                <TextView
                    android:id="@+id/tabHighlights"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Highlights"
                    android:textColor="#536471"/>

                <TextView
                    android:id="@+id/tabMedia"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Media"
                    android:textColor="#536471"/>
            </LinearLayout>

            <!-- Selected tab indicator -->
            <View
                android:layout_width="72dp"
                android:layout_height="4dp"
                android:layout_marginStart="12dp"
                android:background="#1D9BF0"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EFF3F4"/>

            <!-- User's tweets -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerProfilePosts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>

            <TextView
                android:id="@+id/textProfileEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp"
                android:gravity="center"
                android:text="No posts yet"
                android:textColor="#536471"
                android:visibility="gone"/>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
