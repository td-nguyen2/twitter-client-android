<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <!-- Top bar: back arrow + "Post" -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/detail_back_button"
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="&#8592;"
            android:textColor="#0F1419"
            android:textSize="24sp"
            android:contentDescription="Back"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Post"
            android:textColor="#0F1419"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/detail_more_button"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="&#8943;"
            android:textColor="#536471"
            android:textSize="24sp"
            android:contentDescription="More post options"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EFF3F4" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <ScrollView
        android:id="@+id/detail_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Author -->
            <LinearLayout
                android:id="@+id/detail_author_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="16dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/detail_avatar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ui_default_avatar"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/detail_display_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="#0F1419"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/detail_username"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="#536471"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/detail_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:lineSpacingExtra="4dp"
                android:textColor="#0F1419"
                android:textIsSelectable="true"
                android:textSize="20sp" />

            <ImageView
                android:id="@+id/detail_media"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:adjustViewBounds="true"
                android:maxHeight="480dp"
                android:scaleType="fitStart"
                android:contentDescription="Post image"
                android:visibility="gone" />

            <TextView
                android:id="@+id/detail_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:textColor="#536471"
                android:textSize="14sp" />

            <!-- Reposts / Likes -->
            <View
                android:id="@+id/detail_stats_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EFF3F4" />

            <LinearLayout
                android:id="@+id/detail_stats_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/detail_stat_reposts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="20dp"
                    android:textColor="#536471"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/detail_stat_replies"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="20dp"
                    android:textColor="#536471"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/detail_stat_likes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#536471"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/detail_stat_views"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:textColor="#536471"
                    android:textSize="14sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EFF3F4" />

            <!-- Action row: reply, repost, like, share -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:id="@+id/detail_reply_container"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Reply"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ui_icon_reply"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/detail_repost_container"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Repost"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/detail_repost_icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ui_icon_repost"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/detail_like_container"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Like"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/detail_like_icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ui_icon_heart"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/detail_bookmark_container"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Bookmark"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/detail_bookmark_icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ui_icon_bookmark"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/detail_share_container"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Share"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ui_icon_share"
                        android:importantForAccessibility="no" />
                </FrameLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EFF3F4" />

            <TextView
                android:id="@+id/detail_replies_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp"
                android:gravity="center"
                android:text="No replies yet. Be the first to reply."
                android:textColor="#536471"
                android:textSize="15sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/detail_replies_loading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:indeterminateTint="#1D9BF0" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Loading replies…"
                    android:textColor="#536471"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/detail_replies_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/detail_replies_error_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Couldn’t load replies. Check your connection and try again."
                    android:textColor="#536471"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/detail_replies_retry"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="Try again"
                    android:textColor="#1D9BF0"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/replies_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

        <LinearLayout
            android:id="@+id/detail_post_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:background="#FFFFFF"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/detail_post_loading"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:indeterminateTint="#1D9BF0" />

            <TextView
                android:id="@+id/detail_post_state_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Loading post…"
                android:textColor="#536471"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/detail_post_retry"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="Try again"
                android:textColor="#1D9BF0"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EFF3F4" />

    <!-- Reply bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/detail_replying_to"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="46dp"
            android:layout_marginBottom="6dp"
            android:textColor="#536471"
            android:textSize="13sp" />

        <!-- Selected image/GIF preview -->
        <LinearLayout
            android:id="@+id/reply_media_preview_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:layout_marginStart="46dp"
            android:layout_marginBottom="8dp">

            <ImageView
                android:id="@+id/reply_media_preview"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:scaleType="centerCrop"
                android:contentDescription="Selected reply media" />

            <TextView
                android:id="@+id/reply_media_remove"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:padding="8dp"
                android:text="Remove"
                android:textColor="#F4212E"
                android:textSize="14sp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/detail_my_avatar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ui_default_avatar"
                android:importantForAccessibility="no" />

            <EditText
                android:id="@+id/reply_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/ui_input_background"
                android:hint="Post your reply"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="4"
                android:minHeight="44dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textColor="#0F1419"
                android:textColorHint="#536471"
                android:textSize="15sp" />

            <!-- Attach image/GIF -->
            <TextView
                android:id="@+id/reply_media_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="＋"
                android:textColor="#1D9BF0"
                android:textSize="26sp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Attach image or GIF" />

            <TextView
                android:id="@+id/reply_button"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Reply"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/ui_reply_button_bg" />

        </LinearLayout>
    </LinearLayout>
</LinearLayout>
